#!/usr/bin/env python3
"""agent-dash: read-only panel listing the Jetski subagents started from one Rex terminal.

    agent-dash BLOCK                  curses panel (refreshes every second)
    agent-dash --once BLOCK           print the list once as plain text
    agent-dash --view CHILD BLOCK     print one subagent's view, fully unfolded (CHILD may be a prefix)

BLOCK is the Rex block id of the Jetski pane. agent-dash-hook records each subagent start in
${XDG_STATE_HOME:-~/.local/state}/agent-dash/BLOCK.jsonl and opens this panel in a Rex
floating layer. The list groups subagent trees under Working and Completed. Each subagent's
state comes from its transcript:

    error    the last step failed (a model or system step, not a failed tool call)
    waiting  it ended its turn after starting background work (a command or timer) in that turn
    done     it ended its turn otherwise
    quiet    not ended, and the transcript hasn't changed for 5 minutes
    working  anything else

The live view (enter) is shaped like the Jetski web subagent view: one summary line per step
(Ran ..., Analyzed ..., Edited ... +a -b, Reply: ...), grouped under the message that started
the turn (Message from parent, Task finished: ...). Every line folds; running steps are unfolded
and stream their output (background commands: their log).

List keys: up/down or k/j move, enter opens the live view, q closes the panel.
View keys: up/down k/j move, PgUp/PgDn page, g first, G newest (follow), enter/space fold,
a fold/unfold all, o whole transcript in less, q or escape back to the list.

The panel only reads files. It never sends anything to an agent or a terminal, so closing it
(q, or closing the layer) stops nothing but the panel.
"""

import collections
import curses
import json
import os
import re
import subprocess
import sys
import tempfile
import time

QUIET_AFTER = 300  # seconds without transcript changes before a running subagent shows "quiet"
REFRESH_MS = 1000
CMD_TAIL = 200     # run_command output: last N lines
RESULT_HEAD = 8    # other tool results: first N lines
LOG_TAIL = 50      # running background command: last N log lines
LOG_BYTES = 65536  # ... read from the last N bytes of its log
MAIN_ARGS = ("AbsolutePath", "Path", "TargetFile", "Url", "query", "Query", "Role", "Recipient", "TaskId", "Name")
FILE_ARGS = ("AbsolutePath", "Path", "TargetFile", "File", "FilePath")
VERBS = {
    "read_file": "Analyzed", "view_file": "Analyzed", "view_file_outline": "Analyzed",
    "edit_file": "Edited", "replace_file_content": "Edited", "multi_replace_file_content": "Edited",
    "write_file": "Created", "write_to_file": "Created",
    "list_dir": "Listed", "grep_search": "Searched", "find_by_name": "Searched", "search_web": "Searched",
    "invoke_subagent": "Started subagent", "define_subagent": "Defined subagent",
}

ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(\x07|\x1b\\)|\x1b[@-Z\\-_]")
CTRL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")
BG_START = re.compile(r"running as a background task with task id:\s*(\S+)")
BG_LOG = re.compile(r"Task logs are available at:\s*file://(\S+)")
BG_DONE = re.compile(r'Task id "([^"]+)" finished with result:\s*(.*?)(?:\nLog: file://\S+\s*)?(?:</SYSTEM_MESSAGE>|$)', re.S)
SENDER = re.compile(r"sender=(\S+)")


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "agent-dash")


def clean(text):
    """Terminal-safe text: no escape sequences, no control characters, no CRs."""
    text = ANSI.sub("", text or "").replace("\r\n", "\n").replace("\r", "\n").replace("\t", "    ")
    return CTRL.sub("", text)


def oneline(text, limit=160):
    return " ".join(str(text or "").split())[:limit]


def first_line(text, limit=200):
    for line in (text or "").splitlines():
        line = line.strip().lstrip("#>*- ").strip()
        if line and not line.startswith("```") and not line.startswith("|"):
            return line[:limit]
    return ""


def arg(call, key):
    """Tool argument values are JSON-encoded inside the transcript ("\\"sleep 25\\""); decode them."""
    v = (call.get("args") or {}).get(key)
    if isinstance(v, str) and v[:1] in "\"[{":
        try:
            v = json.loads(v)
        except ValueError:
            pass
    return v


def nlines(text):
    return len(str(text).split("\n")) if text else 0


def summary(call):
    """One-line summary of a tool call, like the Jetski web view: (verb, object)."""
    name = call.get("name") or "?"
    if name == "run_command":
        return "Ran", oneline(arg(call, "toolSummary") or arg(call, "CommandLine"))
    if name == "schedule":
        when = arg(call, "DurationSeconds")
        when = ("%ss" % when) if when else (arg(call, "CronExpression") or "")
        return "Timer", ("%s %s" % (when, oneline(arg(call, "Prompt"), 120))).strip()
    if name == "send_message":
        return "Sent message", oneline(arg(call, "Message"), 120)
    verb = VERBS.get(name)
    path = next((arg(call, k) for k in FILE_ARGS if isinstance(arg(call, k), str)), None)
    if verb and path:
        obj = os.path.basename(path.rstrip("/")) or path
        if verb == "Analyzed" and arg(call, "StartLine"):
            obj += " #L%s-%s" % (arg(call, "StartLine"), arg(call, "EndLine") or "")
        if verb == "Edited":
            add, rem = nlines(arg(call, "Replacement") or arg(call, "ReplacementContent")), \
                nlines(arg(call, "Target") or arg(call, "TargetContent"))
            if add or rem:
                obj += " +%d -%d" % (add, rem)
        return verb, obj
    for k in MAIN_ARGS:
        v = arg(call, k)
        if isinstance(v, str) and v.strip():
            return (verb or name), oneline(v)
    return (verb or name), ""


def short(call):
    """Row text for a call: the command itself for run_command, else the summary."""
    if (call.get("name") or "") == "run_command":
        return "$ " + oneline(arg(call, "CommandLine"), 400)
    v, o = summary(call)
    return ("%s %s" % (v, o)).strip()


def result_text(content):
    lines = [l for l in clean(content).split("\n")
             if not l.startswith("Created At:") and not l.startswith("Completed At:")]
    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and not lines[-1].strip():
        lines.pop()
    return lines


def message_text(content):
    t = clean(content)
    m = re.search(r"content=(.*?)(?:</SYSTEM_MESSAGE>|$)", t, re.S)
    if not m:
        m = re.search(r"<SYSTEM_MESSAGE>(.*?)(?:</SYSTEM_MESSAGE>|$)", t, re.S)
    if m:
        t = m.group(1)
    return [l for l in t.strip().split("\n") if not l.startswith("Log: file://")]


def tail_file(path, nlines_, nbytes=LOG_BYTES):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - nbytes))
            data = f.read()
    except OSError:
        return []
    lines = clean(data.decode("utf-8", "replace")).split("\n")
    if size > nbytes:
        lines = lines[1:]  # first line is likely cut
    while lines and not lines[-1].strip():
        lines.pop()
    return lines[-nlines_:]


def limit(lines, tool):
    if tool == "run_command":
        if len(lines) > CMD_TAIL:
            return [("dim", "... %d earlier lines" % (len(lines) - CMD_TAIL))] + [("out", l) for l in lines[-CMD_TAIL:]]
        return [("out", l) for l in lines]
    if len(lines) > RESULT_HEAD:
        return [("out", l) for l in lines[:RESULT_HEAD]] + [("dim", "... %d more lines" % (len(lines) - RESULT_HEAD))]
    return [("out", l) for l in lines]


class Transcript:
    """Follows one transcript.jsonl (reading only new bytes) and keeps it as display events."""

    def __init__(self, path):
        self.path = path
        self.mtime = 0.0
        self.reset()

    def reset(self):
        self.offset = 0
        self.partial = b""
        self.events = []
        self.pending = collections.deque()  # call events waiting for their result
        self.bg = {}                         # task id -> call event
        self.turn_bg = False                 # background work started in the current turn
        self.last = None                     # {"final", "error", "text"}
        self.nsteps = 0

    def poll(self):
        try:
            st = os.stat(self.path)
        except OSError:
            return
        self.mtime = st.st_mtime
        if st.st_size < self.offset:  # rewritten: start over
            self.reset()
        if st.st_size == self.offset:
            return
        try:
            with open(self.path, "rb") as f:
                f.seek(self.offset)
                data = f.read()
        except OSError:
            return
        self.offset += len(data)
        lines = (self.partial + data).split(b"\n")
        self.partial = lines.pop()
        for raw in lines:
            if not raw.strip():
                continue
            try:
                step = json.loads(raw)
            except ValueError:
                continue
            if isinstance(step, dict):
                try:
                    self.add(step)
                except Exception:  # one odd step must not break the panel
                    pass

    def add(self, step):
        kind = step.get("type") or ""
        status = step.get("status") or ""
        content = step.get("content") if isinstance(step.get("content"), str) else ""
        error = status == "ERROR" and kind != "GENERIC"  # GENERIC ERROR = a failed tool call
        first = self.nsteps == 0
        self.nsteps += 1

        if kind == "PLANNER_RESPONSE":
            calls = [c for c in (step.get("tool_calls") or []) if isinstance(c, dict)]
            if content.strip():
                self.events.append({"kind": "reply", "lines": clean(content).strip().split("\n")})
            for c in calls:
                verb, obj = summary(c)
                ev = {"kind": "call", "tool": c.get("name") or "?", "verb": verb, "obj": obj,
                      "cmd": oneline(arg(c, "CommandLine"), 100000) if c.get("name") == "run_command" else None,
                      "result": None, "failed": False, "task": None, "log": None, "final": None}
                self.events.append(ev)
                self.pending.append(ev)
            if calls:
                self.last = {"final": False, "error": error, "text": short(calls[-1])}
            else:
                self.last = {"final": not error, "error": error,
                             "text": first_line(content) or (self.last or {}).get("text", "")}
        elif kind == "GENERIC":
            lines = result_text(content)
            ev = self.pending.popleft() if self.pending else None
            if ev is None:
                ev = {"kind": "call", "tool": "?", "verb": "Result", "obj": "", "cmd": None, "result": None,
                      "failed": False, "task": None, "log": None, "final": None}
                self.events.append(ev)
            ev["result"] = lines
            ev["failed"] = status == "ERROR"
            text = "\n".join(lines)
            m = BG_START.search(text)
            if m:
                ev["task"] = m.group(1)
                lm = BG_LOG.search(text)
                ev["log"] = lm.group(1) if lm else None
                self.bg[ev["task"]] = ev
                self.turn_bg = True
            self.last = {"final": False, "error": False, "text": (self.last or {}).get("text", "")}
        elif kind in ("SYSTEM_MESSAGE", "USER_INPUT"):
            self.turn_bg = False  # a new turn starts
            c = clean(content)
            done = BG_DONE.search(c)
            sender = SENDER.search(c)
            turn = {"kind": "turn", "first": first, "user": kind == "USER_INPUT",
                    "sender": sender.group(1) if sender else None, "task": None,
                    "lines": message_text(content) if kind == "SYSTEM_MESSAGE" else c.strip().split("\n")}
            if done and done.group(1) in self.bg:
                tev = self.bg[done.group(1)]
                tev["final"] = done.group(2).strip().split("\n")
                turn["task"] = tev
            self.events.append(turn)
            self.last = {"final": False, "error": error, "text": "[message]"}
        elif error:
            self.events.append({"kind": "turn", "first": False, "user": False, "sender": None, "task": None,
                                "error": True, "lines": result_text(content)})
            self.last = {"final": False, "error": True, "text": first_line(content)}

    def state(self, now):
        s = self.last
        if s is None:
            if self.mtime and now - self.mtime > QUIET_AFTER:
                return "quiet", ""
            return "working", ""
        if s["error"]:
            return "error", s["text"]
        if s["final"]:
            return ("waiting" if self.turn_bg else "done"), s["text"]
        if self.mtime and now - self.mtime > QUIET_AFTER:
            return "quiet", s["text"]
        return "working", s["text"]

    def items(self, names, parent):
        """Foldable items: dicts with key, depth, title, style, running, failed, body()."""
        out = []
        for i, ev in enumerate(self.events):
            if ev["kind"] == "turn":
                out.append({"key": i, "depth": 0, "title": turn_title(ev, names, parent), "style": "msg",
                            "running": False, "failed": ev.get("error", False),
                            "body": (lambda ev=ev: [("msgbody", l) for l in ev["lines"]])})
            elif ev["kind"] == "reply":
                out.append({"key": i, "depth": 1, "title": "Reply: " + (first_line("\n".join(ev["lines"])) or "..."),
                            "style": "reply", "running": False, "failed": False,
                            "body": (lambda ev=ev: [("reply", l) for l in ev["lines"]])})
            else:
                running = ev["result"] is None or (ev["task"] is not None and ev["final"] is None
                                                   and ev["tool"] != "schedule")
                verb = ev["verb"]
                if running and verb == "Ran":
                    verb = "Running"
                out.append({"key": i, "depth": 1, "title": ("%s %s" % (verb, ev["obj"])).strip(),
                            "style": "step", "running": running, "failed": ev["failed"],
                            "body": (lambda ev=ev: call_body(ev))})
        return out


def turn_title(ev, names, parent):
    if ev.get("error"):
        return "Error"
    if ev["first"]:
        return "Message from parent"
    if ev["user"]:
        return "Message from user"
    if ev["task"] is not None:
        return "Task finished: %s" % ev["task"]["obj"]
    s = ev["sender"] or ""
    if "/task-" in s:  # a timer (or other background task) speaking
        return "Timer: %s" % (first_line("\n".join(ev["lines"])) or s.split("/")[-1])
    if s:
        return "Message from %s" % ("parent" if s == parent else names.get(s) or s[:8])
    return "Message"


def call_body(ev):
    out = []
    if ev["cmd"]:
        out.append(("cmd", "$ " + ev["cmd"]))
    if ev["task"] and ev["final"] is None and ev["tool"] != "schedule":
        out.append(("dim", "[running in background: %s]" % ev["task"].split("/")[-1]))
        out += [("out", l) for l in (tail_file(ev["log"], LOG_TAIL) if ev["log"] else [])]
    elif ev["task"] and ev["final"] is not None:
        out += limit(ev["final"], ev["tool"])
    elif ev["result"] is None:
        out.append(("dim", "..."))
    else:
        out += limit(ev["result"], ev["tool"])
    return out


def layout(items, expanded, width=None):
    """Lines as (item index, style, text). expanded(item) says whether to show its body."""
    lines = []
    for n, it in enumerate(items):
        ind = "  " * it["depth"]
        open_ = expanded(it)
        mark = "v " if open_ else "> "
        flag = "* " if it["running"] else ("x " if it["failed"] else "")
        style = "running" if it["running"] else ("failed" if it["failed"] else it["style"])
        lines += [(n, style, t) for t in wrap(ind + mark + flag + it["title"], width, ind + "    ")]
        if open_:
            for st, text in it["body"]():
                lines += [(n, st, t) for t in wrap(ind + "    " + text, width, ind + "    ")]
    return lines


def wrap(text, width, indent=""):
    if not width or len(text) <= width:
        return [text]
    width = max(len(indent) + 10, width)
    out = [text[:width]]
    text = text[width:]
    step = width - len(indent)
    while text:
        out.append(indent + text[:step])
        text = text[step:]
    return out


def read_registry(block):
    recs, seen = [], set()
    try:
        with open(os.path.join(state_dir(), block + ".jsonl"), encoding="utf-8") as f:
            for raw in f:
                try:
                    r = json.loads(raw)
                except ValueError:
                    continue
                child = isinstance(r, dict) and r.get("child")
                if child and child not in seen:
                    seen.add(child)
                    recs.append(r)
    except OSError:
        pass
    return recs


def transcript_path(rec):
    p = rec.get("transcript") or ""
    if p:
        return p
    return os.path.join(os.path.expanduser("~"), ".gemini", "jetski", "brain", rec["child"],
                        ".system_generated", "logs", "transcript.jsonl")


def ordered(recs):
    """Trees in display order: [(root, [(depth, rec), ...])], newest root first, children in start order."""
    ids = {r["child"] for r in recs}
    kids = {}
    for r in recs:
        kids.setdefault(r.get("parent"), []).append(r)
    tops = sorted((r for r in recs if r.get("parent") not in ids), key=lambda r: r.get("ts", 0), reverse=True)
    seen, trees = set(), []

    def walk(r, depth, acc):
        if r["child"] in seen:
            return
        seen.add(r["child"])
        acc.append((depth, r))
        for k in sorted(kids.get(r["child"], []), key=lambda k: k.get("ts", 0)):
            walk(k, depth + 1, acc)

    for r in tops + recs:  # leftovers (a cycle in bad data) still show
        acc = []
        walk(r, 0, acc)
        if acc:
            trees.append(acc)
    return trees


def age(seconds):
    seconds = max(0, int(seconds))
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm" % (seconds // 60)
    return "%dh%02dm" % (seconds // 3600, seconds % 3600 // 60)


ACTIVE = ("working", "waiting", "quiet")


class Model:
    def __init__(self, block):
        self.block = block
        self.tails = {}
        self.names = {}

    def rows(self):
        """Display rows grouped: [("Working", [row...]), ("Completed", [row...])]."""
        now = time.time()
        recs = read_registry(self.block)
        self.names = {r["child"]: (r.get("role") or r.get("type") or r["child"][:8]) for r in recs}
        working, completed = [], []
        for tree in ordered(recs):
            rows = []
            for depth, r in tree:
                t = self.tails.get(r["child"])
                if t is None:
                    t = self.tails[r["child"]] = Transcript(transcript_path(r))
                t.poll()
                state, text = t.state(now)
                rows.append({"id": r["child"], "depth": depth, "role": self.names[r["child"]], "state": state,
                             "age": age(now - (r.get("ts") or now)), "text": text, "t": t,
                             "parent": r.get("parent")})
            (working if any(x["state"] in ACTIVE for x in rows) else completed).extend(rows)
        return [("Working", working), ("Completed", completed)]

    def items(self, row):
        return row["t"].items(self.names, row["parent"])


def flat(groups):
    return [r for _, rows in groups for r in rows]


def row_text(row):
    name = ("  " * row["depth"] + row["role"])[:24]
    return "  %-24s %-7s %6s  %s" % (name, row["state"], row["age"], row["text"])


def plain(model, row):
    return [text for _, _, text in layout(model.items(row), lambda it: True)]


def pager(stdscr, model, row):
    fd, path = tempfile.mkstemp(prefix="agent-dash-", suffix=".txt")
    with os.fdopen(fd, "w", encoding="utf-8") as w:
        w.write("\n".join(plain(model, row)) + "\n")
    curses.endwin()
    try:
        prompt = " %s (read-only)  q back, / search" % row["role"]
        subprocess.call(["less", "-R", "+G", "-P", re.sub(r"([?:.%\\])", r"\\\1", prompt), path])
    except OSError:
        pass
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    stdscr.clear()


COLOR = {"working": 1, "running": 1, "done": 2, "error": 3, "failed": 3, "quiet": 4, "dim": 4,
         "waiting": 5, "msg": 6, "cmd": 6}
BOLD = ("cmd", "msg", "running", "step")


def attr(name):
    a = curses.A_BOLD if name in BOLD else 0
    if curses.has_colors() and name in COLOR:
        a |= curses.color_pair(COLOR[name])
    return a


def put(stdscr, y, text, w, a=0):
    try:
        stdscr.addnstr(y, 0, text.ljust(w), w, a)
    except curses.error:
        pass


class View:
    """Live view state for one subagent: cursor item, fold overrides, follow, screen anchor."""

    def __init__(self, child):
        self.child = child
        self.cursor = None   # item key under the cursor
        self.folds = {}      # item key -> expanded (user's choice)
        self.follow = True
        self.anchor = 0      # cursor line's row on screen, kept while not following
        self.all = None      # None, True (all open) or False (all closed)

    def expanded(self, it):
        if it["key"] in self.folds:
            return self.folds[it["key"]]
        if self.all is not None:
            return self.all
        return it["running"]


def draw_view(stdscr, model, row, v, h, w):
    items = model.items(row)
    keys = [it["key"] for it in items]
    if v.follow or v.cursor not in keys:
        v.cursor = keys[-1] if keys else None
    cur = keys.index(v.cursor) if keys else 0
    lines = layout(items, v.expanded, w)
    body = max(1, h - 1)
    first = next((i for i, l in enumerate(lines) if l[0] == cur), 0)
    if v.follow:
        top = max(0, len(lines) - body)
    else:
        top = max(0, min(first - v.anchor, max(0, len(lines) - body)))
        if first < top or first >= top + body:
            top = max(0, first - body // 3)
    v.anchor = first - top
    title = " %s [%s]  j/k move  enter fold  a all  G follow  o pager  q back" % (row["role"], row["state"])
    put(stdscr, 0, title, w, curses.A_REVERSE)
    for i, (n, style, text) in enumerate(lines[top: top + body]):
        a = attr(style)
        if n == cur and lines[top + i] is lines[first]:
            a |= curses.A_REVERSE
        put(stdscr, 1 + i, text, w, a)
    return items, keys, cur, lines, top, body


def view_key(stdscr, key, model, row, v, items, keys, cur, lines, top, body):
    """Handle one key in the live view; returns False to go back to the list."""
    if key in (ord("q"), ord("Q"), 27, curses.KEY_LEFT):
        return False
    if not keys:
        return True
    if key in (curses.KEY_DOWN, ord("j")):
        v.cursor = keys[min(cur + 1, len(keys) - 1)]
        v.anchor = min(v.anchor + 1, body - 1)
        v.follow = False
    elif key in (curses.KEY_UP, ord("k")):
        v.cursor, v.follow = keys[max(cur - 1, 0)], False
        v.anchor = max(v.anchor - 1, 0)
    elif key in (curses.KEY_NPAGE, 4):  # PgDn, ctrl+d
        n = lines[min(len(lines) - 1, top + body)][0] if lines else cur
        v.cursor, v.follow = keys[max(cur, n)], False
    elif key in (curses.KEY_PPAGE, 21):  # PgUp, ctrl+u
        n = lines[max(0, top - body)][0] if lines else cur
        v.cursor, v.follow, v.anchor = keys[min(cur, n)], False, 0
    elif key in (ord("g"), curses.KEY_HOME):
        v.cursor, v.follow, v.anchor = keys[0], False, 0
    elif key in (ord("G"), curses.KEY_END):
        v.follow = True
    elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
        it = items[cur]
        v.folds[it["key"]] = not v.expanded(it)
        v.follow = False
    elif key == ord("a"):
        v.all = not all(v.expanded(it) for it in items)
        v.folds = {}
    elif key == ord("o"):
        pager(stdscr, model, row)
    return True


def run_curses(stdscr, model):
    curses.curs_set(0)
    stdscr.timeout(REFRESH_MS)
    if curses.has_colors():
        curses.use_default_colors()
        for n, c in ((1, curses.COLOR_YELLOW), (2, curses.COLOR_GREEN), (3, curses.COLOR_RED),
                     (4, curses.COLOR_MAGENTA), (5, curses.COLOR_BLUE), (6, curses.COLOR_CYAN)):
            curses.init_pair(n, c, -1)
    selected, top = None, 0
    views, viewing = {}, None
    while True:
        groups = model.rows()
        rows = flat(groups)
        ids = [r["id"] for r in rows]
        h, w = stdscr.getmaxyx()
        body = max(1, h - 1)
        stdscr.erase()

        if viewing in ids:
            row = rows[ids.index(viewing)]
            v = views.setdefault(viewing, View(viewing))
            state = draw_view(stdscr, model, row, v, h, w)
            stdscr.refresh()
            if not view_key(stdscr, stdscr.getch(), model, row, v, *state):
                viewing = None
            continue
        viewing = None

        idx = ids.index(selected) if selected in ids else 0
        put(stdscr, 0, " Subagents  j/k move  enter view  q close", w, curses.A_REVERSE)
        lines = []  # (row index or None, text, attr)
        for name, grows in groups:
            if not grows:
                continue
            lines.append((None, name, curses.A_BOLD | curses.A_UNDERLINE))
            for r in grows:
                lines.append((ids.index(r["id"]), row_text(r), attr(r["state"])))
        if not rows:
            lines.append((None, " No subagents yet.", 0))
        sel = next((i for i, l in enumerate(lines) if l[0] == idx), 0)
        if sel < top:
            top = max(0, sel - 1)
        elif sel >= top + body:
            top = sel - body + 1
        for i, (n, text, a) in enumerate(lines[top: top + body]):
            put(stdscr, 1 + i, text, w, a | (curses.A_REVERSE if n == idx and rows else 0))
        stdscr.refresh()
        selected = ids[idx] if rows else None

        key = stdscr.getch()
        if key in (ord("q"), ord("Q")):
            return
        if key in (curses.KEY_DOWN, ord("j")) and rows:
            selected = ids[min(idx + 1, len(ids) - 1)]
        elif key in (curses.KEY_UP, ord("k")) and rows:
            selected = ids[max(idx - 1, 0)]
        elif key in (curses.KEY_ENTER, 10, 13, curses.KEY_RIGHT) and rows:
            viewing = ids[idx]
            views[viewing] = View(viewing)  # open following the newest step
        # every other key: nothing


def main(argv):
    once = "--once" in argv
    view = "--view" in argv
    args = [a for a in argv if a not in ("--once", "--view")]
    if len(args) != (2 if view else 1):
        sys.stderr.write("usage: agent-dash [--once] BLOCK | --view CHILD BLOCK\n")
        return 2
    model = Model(args[-1])
    if view:
        for row in flat(model.rows()):
            if row["id"].startswith(args[0]):
                print("\n".join(plain(model, row)))
                return 0
        sys.stderr.write("no subagent %s for %s\n" % (args[0], args[-1]))
        return 1
    if once:
        groups = model.rows()
        if not flat(groups):
            print("No subagents yet.")
        for name, rows in groups:
            if rows:
                print(name)
                for row in rows:
                    print(row_text(row))
        return 0
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(run_curses, model)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
