#!/usr/bin/env bash
# emacs-editor: $EDITOR and `alias emacs=emacs-editor` on every host.
#
#   any arg starting with "-"   -> real emacs, args unchanged (emacs --version, -Q, --daemon, ...)
#   no server reachable         -> emacs -nw -q   (fast terminal fallback, no init files)
#   inside an Emacs terminal    -> emacsclient    (open in the server you are in)
#   in a terminal               -> emacsclient -nw
#   no terminal (GUI caller)    -> emacsclient -c (new frame from the server)
#
# The emacs alias is zsh-only, so `emacs` below is always the real binary on PATH.

for arg in "$@"; do
  if [[ "$arg" == -* ]]; then
    exec emacs "$@"
  fi
done

if ! emacsclient -e t > /dev/null 2>&1; then
  exec emacs -nw -q "$@"
fi

if [[ -n "$INSIDE_EMACS" ]]; then
  exec emacsclient "$@"
fi

if [[ -t 0 && -t 1 ]]; then
  exec emacsclient -nw "$@"
fi

exec emacsclient -c "$@"
